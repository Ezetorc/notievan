{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true
  },

  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
