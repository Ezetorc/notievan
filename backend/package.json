{
	"name": "@app/backend",
	"type": "module",
	"scripts": {
		"dev": "cd ../ && bun --watch --env-file=backend/.env backend/src/index.ts",
		"build": "bun build ./src/index.ts --outdir dist --minify --target bun --external playwright --external playwright-core --external chromium-bidi",
		"check": "bunx biome check --write .",
		"test": "bun --env-file=./.env vitest",
		"db:migrate": "bun src/database/migrate.script.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:push": "bunx drizzle-kit push",
		"db:studio": "bunx drizzle-kit studio"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@sparticuz/chromium": "^148.0.0",
		"bcrypt": "^6.0.0",
		"cloudinary": "^2.8.0",
		"cors": "^2.8.5",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"pg": "^8.20.0",
		"playwright": "^1.59.1",
		"playwright-core": "^1.59.1",
		"resolve-from": "^5.0.0",
		"sharp": "^0.34.5",
		"vitest": "^4.1.6",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "^1.3.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.19.39",
		"@types/pg": "^8.20.0",
		"typescript": "^5.9.3"
	}
}
