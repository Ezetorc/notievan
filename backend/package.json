{
	"name": "@app/backend",
	"type": "module",
	"scripts": {
		"build": "npm run db:migrate && tsup src/index.ts --format esm --out-dir dist --minify",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"lint": "npx @biomejs/biome lint --write",
		"format": "npx @biomejs/biome format --write",
		"test": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@sparticuz/chromium": "^148.0.0",
		"bcrypt": "^6.0.0",
		"cloudinary": "^2.8.0",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"pg": "^8.20.0",
		"playwright": "^1.59.1",
		"playwright-core": "^1.59.1",
		"resolve-from": "^5.0.0",
		"sharp": "^0.34.5",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.19.39",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	}
}
